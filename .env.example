# Copy this file to .env.local and replace the placeholder values with the
# settings from your own Supabase project. Never commit .env.local.

# Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API -> Publishable key (sb_publishable_...)
# The publishable key is designed for browser use. Never use a secret or
# service-role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Older projects show a legacy "anon" key instead of a publishable key.
# Use this only if your project has no publishable key; it is not needed
# when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional public origin used to build email confirmation and password-reset
# links. Leave unset in local development; set it in production, for example
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Student progress (Phase 5) and the admin workspace (Phase 7) use the same
# Supabase project and public key. Apply supabase/migrations/*.sql before using
# those features, and see docs/progress-database-setup.md and
# docs/admin-database-setup.md. The optional live isolation script reads its two
# disposable test accounts from shell variables (documented in the progress
# guide), never from here.

# Premium membership (Phase 8) -------------------------------------------------
# Everything below is server-only. Never prefix these names with NEXT_PUBLIC_.
# The app runs with all of them unset: free A1-B2 lessons stay available and the
# Premium page shows that checkout is not open yet.
# Read docs/premium-payments-setup.md before filling anything in.

# Optional, server-only. Needed only for the payment webhook, which calls one
# database function with elevated rights. Never send this key to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A hosted-checkout provider name. Only "generic" is implemented; provider
# specific adapters must translate their events into the contract documented in
# docs/premium-payments-setup.md.
# PAYMENTS_PROVIDER=generic

# Server endpoint that creates a hosted checkout session. Replace the host and
# path with your provider's real API. Leaving the example values in place does
# NOT enable checkout unless every other value below is also set.
# PAYMENTS_CHECKOUT_URL=https://payments.example.com/api/checkout
# PAYMENTS_API_KEY=your-provider-api-key
# PAYMENTS_PRODUCT_ID=premium-c1-c2
# PAYMENTS_INTERVAL=month

# The price is always decided on the server from these values. The amount is in
# the currency's minor unit (for example 900 = 9.00).
# PAYMENTS_PRICE_LABEL=Premium membership
# PAYMENTS_PRICE_CURRENCY=USD
# PAYMENTS_PRICE_AMOUNT=900

# Where the provider sends the browser afterwards. These pages only show a
# status message; access is granted solely by a verified webhook.
# PAYMENTS_SUCCESS_URL=https://your-domain.com/premium?checkout=success
# PAYMENTS_CANCEL_URL=https://your-domain.com/premium?checkout=cancelled

# Shared signing secret for webhook deliveries. Use at least 16 characters and
# store it only in your hosting provider's secret settings.
# PAYMENTS_WEBHOOK_SECRET=your-webhook-signing-secret
